{
  "name": "aichat-relay",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Next.js relay gateway for AIChat clients, wire-compatible with the macOS AIChat Relay.",
  "scripts": {
    "dev": "next dev -p 8787",
    "build": "next build",
    "start": "next start -p 8787",
    "typecheck": "tsc --noEmit",
