# AIChat Relay — environment template. Copy to .env and fill in real values.

# -- Required ---------------------------------------------------------------
# Google Gemini API key (held only on the server; clients never see this).
GEMINI_API_KEY=

# Master relay bearer token. Clients send it in `Authorization: Bearer ...`.
# Equivalent to AI_RELAY_BEARER_TOKEN in the watch app's Secrets.xcconfig.
RELAY_BEARER_TOKEN=

# Admin console cookie signing key (>= 32 bytes of entropy).
# openssl rand -hex 32
RELAY_SESSION_SECRET=

# -- Optional ---------------------------------------------------------------
# Listener port (default 8787).
PORT=8787

# Path to the persistent JSON state file. Mount this as a volume in Docker.
RELAY_DATA_DIR=./data

# Upstream Gemini override (default official Google endpoint).
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Initial admin credentials used on first boot only. After setup, manage from UI.
RELAY_ADMIN_USER=admin
RELAY_ADMIN_PASSWORD=

# Debug payload capture (300-entry ring). Set to "1" to enable.
RELAY_DEBUG_LOGGING=0

# StoreKit receipt verification mode: "stub" decodes JWS but does not verify
# signature (matches macOS AIChat Relay behaviour); "strict" is reserved for v1.2.
RELAY_BILLING_MODE=stub
