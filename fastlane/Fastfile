require "open3"
require "pathname"
require "shellwords"

default_platform(:ios)

PROJECT_ROOT = File.expand_path("..", __dir__)
APPLE_TEAM_ID = ENV["APPLE_TEAM_ID"] || "NCLY9ZGRMZ"
TESTFLIGHT_EXTERNAL_GROUP = ENV["TESTFLIGHT_EXTERNAL_GROUP"] || "PBTestGroup"
INFO_PLISTS = [
  "Config/AIChatContainer-Info.plist",
  "Config/WatchApp-Info.plist",
  "Config/AIChatWatchWidget-Info.plist"
].map { |path| File.join(PROJECT_ROOT, path) }.freeze

def require_env!(name)
  value = ENV[name].to_s.strip
  UI.user_error!("Missing required environment variable: #{name}") if value.empty?
  value
end

def require_utf8_locale!
  locale = [ENV["LC_ALL"], ENV["LANG"]].compact.join(" ")
  return if locale.match?(/utf-?8/i)

  UI.user_error!(
    "fastlane needs a UTF-8 locale. Run: export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8"
  )
end

def require_clean_git!(allow_dirty)
  return if allow_dirty

  status = sh("git status --porcelain", log: false).strip
  return if status.empty?

  UI.user_error!(
    "Working tree is dirty. Commit/stash changes first, or pass allow_dirty:true for an emergency local archive."
  )
end

def preflight!(allow_dirty)
  require_utf8_locale!
  require_env!("ASC_KEY_ID")
  require_env!("ASC_ISSUER_ID")
  key_path = require_env!("ASC_KEY_PATH")
  UI.user_error!("ASC_KEY_PATH does not exist: #{key_path}") unless File.file?(key_path)
  require_clean_git!(allow_dirty)
  plist_build_versions
end

def release_notes(options)
  explicit = options[:changelog].to_s.strip
  return explicit unless explicit.empty?

  file = options[:changelog_file].to_s.strip
  file = "TestFlight/WhatToTest.en.txt" if file.empty?
  file = File.join(PROJECT_ROOT, file) unless Pathname.new(file).absolute?
  UI.user_error!("Missing changelog file: #{file}") unless File.file?(file)

  notes = File.read(file, encoding: "UTF-8").strip
  UI.user_error!("Changelog is empty: #{file}") if notes.empty?
  notes
end

def release_build_number(options)
  explicit = options[:build_number].to_s.strip
  return explicit unless explicit.empty?

  Time.now.utc.strftime("%Y%m%d%H%M")
end

def plist_build_versions
  INFO_PLISTS.to_h do |path|
    stdout, stderr, status = Open3.capture3("/usr/libexec/PlistBuddy", "-c", "Print :CFBundleVersion", path)
    UI.user_error!("Could not read CFBundleVersion from #{path}: #{stderr}") unless status.success?
    value = stdout.strip
    [path, value]
  end
end

def xcodebuild_auth_args
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath", ENV.fetch("ASC_KEY_PATH"),
    "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"),
    "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID")
  ].shelljoin
end

def archive_xcargs(build_number)
  [
    "APP_BUILD_VERSION=#{build_number}",
    xcodebuild_auth_args
  ].join(" ")
end

def app_store_connect_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    duration: 1200,
    in_house: false
  )
end

def ensure_distribution_certificate!(api_key)
  get_certificates(
    api_key: api_key,
    team_id: APPLE_TEAM_ID,
    generate_apple_certs: true,
    development: false,
    output_path: File.join(PROJECT_ROOT, "build/fastlane/certificates")
  )
end

platform :ios do
  desc "Verify local manual TestFlight release prerequisites without uploading"
  lane :preflight do |options|
    preflight!(options[:allow_dirty].to_s == "true")
    UI.success("Manual fastlane release preflight passed.")
  end

  desc "Build and upload to TestFlight → distribute to external group"
  lane :beta do |options|
    preflight!(options[:allow_dirty].to_s == "true")
    changelog = release_notes(options)
    build_number = release_build_number(options)

    api_key = app_store_connect_key
    ensure_distribution_certificate!(api_key)

    build_app(
      project: File.join(PROJECT_ROOT, "AIChat.xcodeproj"),
      scheme: "AIChat",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic",
        teamID: APPLE_TEAM_ID
      },
      xcargs: archive_xcargs(build_number),
      clean: true,
      output_directory: File.join(PROJECT_ROOT, "build/fastlane"),
      output_name: "AIChat-#{build_number}",
      silent: false
    )

    # Upload + wait for processing + submit for Beta App Review + distribute to external group.
    upload_to_testflight(
      distribute_external: true,
      groups: [TESTFLIGHT_EXTERNAL_GROUP],
      changelog: changelog,
      notify_external_testers: true,
      skip_waiting_for_build_processing: false,
      reject_build_waiting_for_review: true,

      # Export compliance — HTTPS-only via URLSession is exempt encryption.
      # Without this Apple gates every build behind a manual "uses encryption?" question.
      uses_non_exempt_encryption: false,

      # Beta App Review info — shown to Apple's reviewer on the first build of a new
      # version string. Subsequent builds same version auto-approve without review.
      beta_app_review_info: {
        contact_email: "thebestzhq@outlook.com",
        contact_first_name: "Hanbin",
        contact_last_name: "Zhang",
        contact_phone: "+86 13358169179",
        demo_account_required: false,
        notes: <<~NOTES
          AI chat app for Apple Watch. Primary target is the watchOS app; iOS companion is for activation key registration only. Uses the production relay for LLM requests. No special test account needed.

          Changes in this build:
          #{changelog}
        NOTES
      },

      # Localized What-to-Test text shown inside TestFlight app.
      localized_build_info: {
        "default" => {
          whats_new: changelog
        },
        "zh-Hans" => {
          whats_new: changelog
        }
      }
    )

    UI.success("Uploaded AIChat build #{build_number} to TestFlight group #{TESTFLIGHT_EXTERNAL_GROUP}.")
  end
end
