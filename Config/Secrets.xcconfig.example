// Copy this file to Config/Secrets.xcconfig and fill local values.
// In xcconfig files, `//` starts a comment, so relay URLs must use `/$()/`
// to preserve the double slash after the scheme.

// Relay configuration
AI_RELAY_BASE_URL = http:/$()/127.0.0.1:8787
// Only enable this when your relay tunnel uses a self-signed or otherwise invalid HTTPS certificate.
// AI_RELAY_ALLOW_INSECURE_TLS = YES
GEMINI_MODEL = gemini-3-flash-preview
GEMINI_TRANSCRIPTION_MODEL = gemini-3-flash-preview

// HMAC seed used to sign/verify offline activation codes. The watch verifier
// and the iOS keygen MUST share the same value, otherwise generated codes will
// not validate. A strong checked-in dev default lives in Config/Shared.xcconfig;
// override it here with your own 32-byte hex secret for production builds.
// Generate one with: openssl rand -hex 32
AI_OFFLINE_ACTIVATION_SEED = bb5d850c1cb4231590a18a466287bac25e3ab9c3708ef6c446e4549eb1b6da43

// Optional shared storage container for future iPhone/watch sync.
// APP_GROUP_IDENTIFIER = group.your.company.aichat

// Shared iCloud ubiquity container for cross-device conversation sync.
// ICLOUD_CONTAINER_IDENTIFIER = iCloud.hanbin.AIChat
